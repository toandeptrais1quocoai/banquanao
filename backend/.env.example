PORT=4000
NODE_ENV=development
JWT_SECRET=doi-chuoi-nay-khi-dua-len-may-that

# Local Windows (ODBC + Trusted Connection) — mặc định khi không có DB_USER
DB_AUTH=windows
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=lpc:.
DB_NAME=BanQuanAo

# Cloud / Azure SQL (bỏ DB_AUTH=windows, điền user/password)
# DB_SERVER=your-server.database.windows.net
# DB_NAME=BanQuanAo
# DB_USER=ntshopadmin
# DB_PASSWORD=
# DB_ENCRYPT=true
# DB_TRUST_CERT=false
# DB_PORT=1433

# Frontend production URL (CORS), cách nhau bởi dấu phẩy nếu nhiều
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Gmail gửi OTP quên mật khẩu (App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=NT shop
