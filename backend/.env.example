PORT=4000
NODE_ENV=development
JWT_SECRET=doi-chuoi-nay-khi-dua-len-may-that

# Local Windows (ODBC + Trusted Connection) — mặc định khi không có DB_USER
DB_AUTH=windows
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=lpc:.
DB_NAME=BanQuanAo

# Cloud / Azure SQL (bỏ DB_AUTH=windows, điền user/password)
# DB_SERVER=your-server.database.windows.net
# DB_NAME=BanQuanAo
# DB_USER=ntshopadmin
# DB_PASSWORD=
# DB_ENCRYPT=true
# DB_TRUST_CERT=false
# DB_PORT=1433

# Frontend production URL (CORS), cách nhau bởi dấu phẩy nếu nhiều
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Gmail gửi OTP quên mật khẩu
# 1) Bật xác minh 2 bước
# 2) Google Tài khoản → Bảo mật → Mật khẩu ứng dụng → tạo cho Mail
# 3) Dán email + 16 ký tự (có khoảng trắng cũng được)
GMAIL_USER=ban@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=NT shop

# VietQR nhận chuyển khoản (mã NH: MB, VCB, TCB, BIDV, ACB, VPB, ...)
# QR tự gắn đúng số tiền đơn + nội dung NT{mã đơn}
VIETQR_BANK=MB
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=NT SHOP

# Chat Ong NT (tuỳ chọn). Không có key vẫn trả lời bằng trợ lý shop + catalog.
# Groq free: https://console.groq.com → GROQ_API_KEY=...
# hoặc OpenAI: OPENAI_API_KEY=...
# GROQ_API_KEY=
# OPENAI_API_KEY=
# CHAT_MODEL=llama-3.1-8b-instant
